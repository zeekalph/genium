# Genium ML Vision Service Environment Variables
# Google AI Studio API Keys (Primary & Fallback)
GOOGLE_API_KEY=your_primary_google_ai_studio_api_key_here
GOOGLE_FALLBACK_API_KEY=your_fallback_google_ai_studio_api_key_here

# Vision Model Identifier
GOOGLE_VISION_MODEL=gemini-2.5-flash

# Port (Automatically assigned by Render via $PORT)
PORT=8000
ENV=production
